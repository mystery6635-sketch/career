# 서버 전용 값. 브라우저에 노출되면 안 되므로 VITE_ 접두사를 붙이지 않는다.
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
# LLM_PROVIDER=mock일 때만(개발·테스트 전용): ok | format-error | fail | slow
# LLM_MOCK_MODE=ok
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=600

# 클라이언트 값. VITE_ 접두사 변수는 번들에 포함되므로 비밀을 두지 않는다.
VITE_AI_MODE=http

# Supabase (2단계 로그인·저장용). anon 키만 VITE_로 둔다. service_role 키는 서버 전용 이름으로만 사용한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
