{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "dist-lib/types",
    "types": ["vite/client"],
    "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": ["src/design-system.ts", "src/components/ui", "shared/messages.ts", "shared/types.ts"]
}
